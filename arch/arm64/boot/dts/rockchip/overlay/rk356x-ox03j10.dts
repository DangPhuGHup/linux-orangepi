/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/clock/rk3568-cru.h>


/ {
	fragment@0 {
		target = <&i2c3>;

        __overlay__ {
            status = "okay";
            clock-frequency = <400000>;

            ox03j10: ox03j10@36 {
                compatible = "ovti,ox03j10";
                status = "okay";
                reg = <0x36>;
                clocks = <&cru CLK_CIF_OUT>;
                clock-names = "xvclk";
                pwdn-gpios = <&gpio3 RK_PC5 GPIO_ACTIVE_HIGH>;
                pinctrl-names = "default";
                pinctrl-0 = <&i2c3m0_xfer>;
                rockchip,camera-module-index = <0>;
                rockchip,camera-module-facing = "back";
                rockchip,camera-module-name = "OX03J10";
                rockchip,camera-module-lens-name = "30IRC-F16";
                
                port {
                    ox03j10_out: endpoint {
                        remote-endpoint = <&mipi_in_cam0>;  // Điểm kết nối với CSI trên RK3566
                        data-lanes = <1 2>;
                    };
                };
            };
        };
	};

	fragment@1 {
        target = <&csi_dphy>;

        __overlay__ {
            status = "okay";
            
            ports {
                #address-cells = <1>;
                #size-cells = <0>;
                
                port@0 {
                    reg = <0>;
                    #address-cells = <1>;
                    #size-cells = <0>;
                    
                    mipi_in_cam0: endpoint@0 {
                        reg = <0>;
                        remote-endpoint = <&ox03j10_out>;
                        data-lanes = <1 2>;
                    };
                };
            };
        };
    };

	fragment@2 {
        target = <&csi2_dphy_hw>;

        __overlay__ {
            status = "okay";
        };
    };

    fragment@3 {
        target = <&mipi_csi2>;

        __overlay__ {
            status = "okay";
        };
    };

    fragment@4 {
        target = <&rkcif_mipi_lvds>;

        __overlay__ {
            status = "okay";
        };
    };

    fragment@5 {
        target = <&rkcif_mipi_lvds_sditf>;

        __overlay__ {
            status = "okay";
        };
    };

    fragment@6 {
        target = <&rkisp>;

        __overlay__ {
            status = "okay";
        };
    };

    fragment@7 {
        target = <&rkisp_mmu>;
        __overlay__ {
            status = "okay";
        };
    };

    fragment@8 {
        target = <&rkisp_vir1>;

        __overlay__ {
            status = "okay";
        };
    };

    fragment@9 {
        target = <&rkcif>;

        __overlay__ {
            status = "okay";
        };
    };

    fragment@10 {
        target = <&rkcif_mmu>;

        __overlay__ {
            status = "okay";
        };
    };
};
